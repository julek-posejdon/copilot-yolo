#!/bin/bash

# Run copilot with full permissions inside a stock Ubuntu container

set -e

IMAGE=ubuntu:latest
HOST_PWD="$(pwd)"

# Run the container
# Parse options
ALLOW_ALL_URLS=0
MODEL="claude-sonnet-4.5"
SKIP_BACKUP=0
ALLOW_GIT=0
GIT_PRESENT=0
ADDITIONAL_DIRS=()

INTERACTIVE=0

# Print resource usage info
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
GREEN='\033[1;32m'
RESET='\033[0m'

if [[ "$1" == "--help" ]]; then
  echo "Usage: copilot-yolo [--enable-network] [--model MODEL] [--skip-backup] [--allow-git] [--add-dir DIR] [<prompt>]"
  echo "  --enable-network   Allow copilot to access all URLs (sets --allow-all-urls)"
  echo "  --model MODEL      Use specified model (default: gpt-4.1)"
  echo "  --skip-backup      Skip backup before running copilot"
  echo "  --allow-git        Allow writing to .git directory (do not mount as read-only)"
  echo "  --add-dir DIR      Mount additional directory (can be specified multiple times)"
  echo "  <prompt>           Prompt to pass to copilot. If omitted, starts an interactive session."
  exit 0
fi

while [[ "$1" == --* ]]; do
  case "$1" in
    --enable-network)
      ALLOW_ALL_URLS=1
      shift
      ;;
    --model)
      MODEL="$2"
      shift 2
      ;;
    --skip-backup)
      SKIP_BACKUP=1
      shift
      ;;
    --allow-git)
      ALLOW_GIT=1
      shift
      ;;
    --add-dir)
      ADDITIONAL_DIRS+=("$2")
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$1" ]]; then
  INTERACTIVE=1
else
  PROMPT="$1"
  shift
fi

if [[ $# -ne 0 ]]; then
  echo "Error: Unexpected extra arguments: $*" >&2
  echo "Try: copilot-yolo --help" >&2
  exit 1
fi

# Detect if .git directory exists or if it's a worktree file
GIT_WORKTREE_SOURCE=""
if [[ -d "$HOST_PWD/.git" ]]; then
  GIT_PRESENT=1
elif [[ -f "$HOST_PWD/.git" ]]; then
  # This is a worktree, .git is a file pointing to the real git directory
  GIT_PRESENT=1
  # Extract the gitdir path from the .git file
  GIT_WORKTREE_SOURCE=$(grep '^gitdir:' "$HOST_PWD/.git" | cut -d' ' -f2-)
  if [[ -n "$GIT_WORKTREE_SOURCE" ]]; then
    # Convert to absolute path if relative
    if [[ "$GIT_WORKTREE_SOURCE" != /* ]]; then
      GIT_WORKTREE_SOURCE="$HOST_PWD/$GIT_WORKTREE_SOURCE"
    fi
    # Resolve to the main .git directory (go up from .git/worktrees/<name>)
    # Worktrees are stored in .git/worktrees/<name>, so we need to go up 2 levels
    GIT_MAIN_DIR="$(dirname "$(dirname "$GIT_WORKTREE_SOURCE")")"
  fi
fi

# If .git is present and not allowing git, skip backup
if [[ $GIT_PRESENT -eq 1 && $ALLOW_GIT -eq 0 ]]; then
  SKIP_BACKUP=1
  echo -e "${YELLOW}[copilot-yolo]${RESET} .git directory detected, skipping backup and will mount .git as read-only."
fi

if [[ $SKIP_BACKUP -eq 0 ]]; then
  DIR_NAME="$(basename "$HOST_PWD")"
  BACKUP_FILE="$(mktemp --suffix=.tar.gz "/tmp/copilot-yolo-backup-${DIR_NAME}-XXXXXX")"
  tar czf "$BACKUP_FILE" .
  echo -e "${YELLOW}[copilot-yolo]${RESET} Backup of current directory created at: ${CYAN}$BACKUP_FILE${RESET}"
  
  # Backup additional directories
  for dir in "${ADDITIONAL_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
      DIR_NAME="$(basename "$dir")"
      BACKUP_FILE="$(mktemp --suffix=.tar.gz "/tmp/copilot-yolo-backup-${DIR_NAME}-XXXXXX")"
      tar czf "$BACKUP_FILE" -C "$(dirname "$dir")" "$(basename "$dir")"
      echo -e "${YELLOW}[copilot-yolo]${RESET} Backup of $dir created at: ${CYAN}$BACKUP_FILE${RESET}"
    fi
  done
fi

MEM_KB=$(grep MemTotal /proc/meminfo | tr -dc '0-9')
MEM_LIMIT="$((MEM_KB / 2 / 1024))m"
CPU_LIMIT=$(($(nproc) > 2 ? $(nproc) - 2 : 1))

printf "${YELLOW}[copilot-yolo]${RESET} Memory limit: ${CYAN}%s${RESET} (half of host RAM)\n" "$MEM_LIMIT"
printf "${YELLOW}[copilot-yolo]${RESET} CPU limit:   ${CYAN}%s${RESET} (host cores minus two)\n" "$CPU_LIMIT"
if [[ $ALLOW_ALL_URLS -eq 1 ]]; then
  printf "${YELLOW}[copilot-yolo]${RESET} Network:     ${CYAN}enabled${RESET}\n"
  URL_ARG="--allow-all-urls"
else
  printf "${YELLOW}[copilot-yolo]${RESET} Network:     ${GREEN}disabled${RESET}\n"
  URL_ARG="--deny-url"
fi
printf "${YELLOW}[copilot-yolo]${RESET} Launching container...\n"

# Detect if /etc/resolv.conf is a symlink and warn
if [[ -L /etc/resolv.conf ]]; then
  echo -e "${YELLOW}[copilot-yolo]${RESET} Warning: /etc/resolv.conf is a symlink. To avoid Docker mount errors, replace it with a real file (e.g. sudo cat /etc/resolv.conf > /tmp/resolv.conf && sudo rm /etc/resolv.conf) && sudo mv /tmp/resolv.conf /etc/resolv.conf."
fi

# Build docker volume args
DOCKER_VOLUMES=(
  -v /usr:/usr:ro
  -v /bin:/bin:ro
  -v /sbin:/sbin:ro
  -v /etc:/etc:ro
  -v "$HOME/.copilot:$HOME/.copilot"
  -v "$HOME/.local:$HOME/.local"
  -v "$HOST_PWD":"$HOST_PWD":rw
)

# Mount .nvm if it exists
if [[ -d "$HOME/.nvm" ]]; then
  DOCKER_VOLUMES+=(-v "$HOME/.nvm:$HOME/.nvm":ro)
fi

# If .git is present and not allowing git, mount .git as read-only
if [[ $GIT_PRESENT -eq 1 && $ALLOW_GIT -eq 0 ]]; then
  DOCKER_VOLUMES+=(-v "$HOST_PWD/.git":"$HOST_PWD/.git":ro)
  # If this is a worktree, also mount the main .git directory
  if [[ -n "$GIT_MAIN_DIR" && -d "$GIT_MAIN_DIR" ]]; then
    DOCKER_VOLUMES+=(-v "$GIT_MAIN_DIR":"$GIT_MAIN_DIR":ro)
  fi
fi

# Mount additional directories and collect their absolute paths
ABS_ADDITIONAL_DIRS=()
for dir in "${ADDITIONAL_DIRS[@]}"; do
  if [[ ! -d "$dir" ]]; then
    echo -e "${YELLOW}[copilot-yolo]${RESET} Warning: Directory $dir does not exist, skipping mount" >&2
    continue
  fi
  
  # Convert to absolute path
  abs_dir="$(cd "$dir" && pwd)"
  ABS_ADDITIONAL_DIRS+=("$abs_dir")
  DOCKER_VOLUMES+=(-v "$abs_dir":"$abs_dir":rw)
  
  # If the additional directory has .git and not allowing git, mount .git as read-only
  if [[ -d "$abs_dir/.git" && $ALLOW_GIT -eq 0 ]]; then
    DOCKER_VOLUMES+=(-v "$abs_dir/.git":"$abs_dir/.git":ro)
  elif [[ -f "$abs_dir/.git" && $ALLOW_GIT -eq 0 ]]; then
    # This is a worktree
    DOCKER_VOLUMES+=(-v "$abs_dir/.git":"$abs_dir/.git":ro)
    # Extract and mount the main .git directory
    ADD_GIT_WORKTREE_SOURCE=$(grep '^gitdir:' "$abs_dir/.git" | cut -d' ' -f2-)
    if [[ -n "$ADD_GIT_WORKTREE_SOURCE" ]]; then
      # Convert to absolute path if relative
      if [[ "$ADD_GIT_WORKTREE_SOURCE" != /* ]]; then
        ADD_GIT_WORKTREE_SOURCE="$abs_dir/$ADD_GIT_WORKTREE_SOURCE"
      fi
      ADD_GIT_MAIN_DIR="$(dirname "$(dirname "$ADD_GIT_WORKTREE_SOURCE")")"
      if [[ -d "$ADD_GIT_MAIN_DIR" ]]; then
        DOCKER_VOLUMES+=(-v "$ADD_GIT_MAIN_DIR":"$ADD_GIT_MAIN_DIR":ro)
      fi
    fi
  fi
done

# Build copilot arguments
COPILOT_ARGS=(--allow-all-paths --allow-all-tools $URL_ARG --model "$MODEL" --no-auto-update)
if [[ $INTERACTIVE -eq 0 ]]; then
  COPILOT_ARGS=(--prompt "$PROMPT" "${COPILOT_ARGS[@]}")
fi

exec docker run --rm \
  --memory $MEM_LIMIT \
  --cpus $CPU_LIMIT \
  "${DOCKER_VOLUMES[@]}" \
  -w "$HOST_PWD" \
  -u $(id -u):$(id -g) \
  -e PATH="$PATH" \
  -e LD_LIBRARY_PATH="$LD_LIBRARY_PATH" \
  -e HOME="$HOME" \
  -e GITHUB_TOKEN="$(gh auth token 2>/dev/null)" \
  -it \
  $IMAGE copilot "${COPILOT_ARGS[@]}"
